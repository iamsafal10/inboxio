# Application Secret Key for JWT / Auth encryption
APP_SECRET_KEY=your_app_secret_key_here

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/inboxio

# ChromaDB Persistence Directory
CHROMA_PERSIST_DIR=./chroma_data

# Google OAuth2 Credentials (Gmail API)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/gmail/oauth/callback

# LLM Provider Configuration
LLM_PROVIDER=ollama
# Options: gemini, groq, openrouter_ox_alpha, ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

LANGCHAIN_TRACING_V2=true
LANGSMITH_API_KEY=your_key_here
LANGSMITH_PROJECT=inboxio