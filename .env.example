# Application Secret Key for JWT / Auth encryption.
# Also derives the Fernet key that encrypts stored Gmail tokens — changing it
# invalidates existing Gmail connections (users must reconnect).
APP_SECRET_KEY=your_app_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Connection URL (docker compose maps host 5433 -> 5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/inboxio

# ChromaDB Persistence Directory
CHROMA_PERSIST_DIR=./chroma_data

# Where the backend redirects after Gmail OAuth completes
FRONTEND_URL=http://localhost:3000

# Google OAuth2 Credentials (Gmail API)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/gmail/oauth/callback

# LLM Provider Configuration
LLM_PROVIDER=groq
# Options: groq, gemini, openrouter_ox_alpha, ollama
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Local fallback provider (no API key needed, but slower and weaker at the
# structured-output calls the planner and tool selector rely on)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Ingestion limits
MAX_EMAILS=25
MAX_CHUNK_CHARS=2000

# Optional tracing
LANGCHAIN_TRACING_V2=true
LANGSMITH_API_KEY=your_key_here
LANGSMITH_PROJECT=inboxio

# Frontend only: backend base URL used by the /api/chat_backend route handler.
# Set in frontend/.env.local, defaults to http://127.0.0.1:8000
# INBOXIO_API_URL=http://127.0.0.1:8000
