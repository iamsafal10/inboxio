# Application Secret Key for JWT / Auth encryption
APP_SECRET_KEY=your_app_secret_key_here

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inboxio

# ChromaDB Persistence Directory
CHROMA_PERSIST_DIR=./chroma_data

# Google OAuth2 Credentials (Gmail API)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/gmail/oauth/callback

# LLM Provider Configuration
LLM_PROVIDER=gemini  # Options: gemini, groq, openrouter_ox_alpha
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
